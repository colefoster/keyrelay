{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/keyrelay/hooks/redact_secrets.py --event UserPromptSubmit",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/keyrelay/hooks/redact_secrets.py --event PostToolUse",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
