[Unit]
Description=Keyrelay one-time credential broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/keyrelay
ExecStart=/usr/bin/python3 /opt/keyrelay/keyrelay.py serve --email you@example.com --port 8765
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
